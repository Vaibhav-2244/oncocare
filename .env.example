NEXT_PUBLIC_SUPABASE_URL=https://example.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key

# Razorpay mode defaults to Test. The key prefix must match this value.
RAZORPAY_MODE=test
# Keep false by default. Set true only with matching Razorpay Test Mode credentials.
PAYMENTS_ENABLED=false
# Demo payment experience is disabled by default and restricted to admin/tester accounts.
PRELAUNCH_DEMO_MODE=false
DEMO_PAYMENTS_ENABLED=false
PRELAUNCH_DEMO_USER_IDS=
# Live real-service checkout is off by default. Enable it only after Razorpay
# activates the account for Live Mode and matching rzp_live_ credentials are set.
LIVE_PAYMENTS_ENABLED=false
# These additional gates apply only to explicitly disclosed pre-launch demo charges.
PRELAUNCH_LIVE_DEMO_COLLECTION_ENABLED=false
PRELAUNCH_LIVE_MERCHANT_NAME=
# Seller transfers are independent of checkout and remain disabled until enabled and approved.
MARKETPLACE_TRANSFERS_ENABLED=false
# BPL campaign donations require verified campaigns plus legal, operational, and merchant approvals.
PATIENT_DONATIONS_ENABLED=false
# Set true only after a real teleconsultation provider and appointment operations are configured.
TELE_ONCOLOGY_CALL_PROVIDER_ENABLED=false

# For Test Mode, use the matching rzp_test_ key ID, key secret, and Test Mode webhook secret.
RAZORPAY_KEY_ID=rzp_test_example
RAZORPAY_KEY_SECRET=replace-with-your-test-secret
RAZORPAY_WEBHOOK_SECRET=replace-with-your-test-webhook-secret

# For Live Mode, set RAZORPAY_MODE=live, LIVE_PAYMENTS_ENABLED=true, and replace
# all three Razorpay values above with the matching Live Mode credentials/secrets.
