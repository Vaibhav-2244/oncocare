NEXT_PUBLIC_SUPABASE_URL=https://example.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key

# Keep false by default. Set true only with Razorpay Test Mode credentials to enable checkout.
PAYMENTS_ENABLED=false
# Seller transfers are independent of checkout and remain disabled until enabled and approved.
MARKETPLACE_TRANSFERS_ENABLED=false
# Donations remain disabled until legal, campaign, and payment-account approvals are complete.
PATIENT_DONATIONS_ENABLED=false
# Set true only after a real teleconsultation provider and appointment operations are configured.
TELE_ONCOLOGY_CALL_PROVIDER_ENABLED=false

RAZORPAY_KEY_ID=rzp_test_example
RAZORPAY_KEY_SECRET=replace-with-your-test-secret
RAZORPAY_WEBHOOK_SECRET=replace-with-your-test-webhook-secret
