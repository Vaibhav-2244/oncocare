# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://example.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-your-supabase-anon-key
# Server only. Never expose this with a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key

# Razorpay credentials must all belong to the same mode. The mode defaults to test.
# Test profile: RAZORPAY_MODE=test, matching rzp_test_ key ID, key secret, and Test
# Mode webhook secret. Keep this profile for preview/testing.
RAZORPAY_MODE=test
RAZORPAY_KEY_ID=rzp_test_replace-with-test-key-id
RAZORPAY_KEY_SECRET=replace-with-test-key-secret
RAZORPAY_WEBHOOK_SECRET=replace-with-test-webhook-secret
PAYMENTS_ENABLED=false
LIVE_PAYMENTS_ENABLED=false

# Pre-launch demo checkout (Test Mode or explicitly authorized Live pilot only).
PRELAUNCH_DEMO_MODE=false
DEMO_PAYMENTS_ENABLED=false
# Comma-separated internal Supabase Auth user UUIDs; platform payment admins are also authorized.
PRELAUNCH_DEMO_USER_IDS=

# Live pilot gates. Set all three only for the disclosed Live internal pilot:
# PRELAUNCH_DEMO_MODE=true, DEMO_PAYMENTS_ENABLED=true, LIVE_PAYMENTS_ENABLED=true,
# PRELAUNCH_LIVE_DEMO_COLLECTION_ENABLED=true, RAZORPAY_MODE=live, and PAYMENTS_ENABLED=true.
# The merchant name must be the registered Razorpay merchant name shown to the payer.
PRELAUNCH_LIVE_DEMO_COLLECTION_ENABLED=false
PRELAUNCH_LIVE_MERCHANT_NAME=

# Keep disabled unless the separate products and operational approvals are complete.
PATIENT_DONATIONS_ENABLED=false
MARKETPLACE_TRANSFERS_ENABLED=false
TELE_ONCOLOGY_CALL_PROVIDER_ENABLED=false
